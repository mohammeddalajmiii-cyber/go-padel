# Copy this file to .env.local and fill in the values.

# Neon database connection string (Neon dashboard → Connect → copy the "pooled" string)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Front desk login password for /admin (choose a strong one)
ADMIN_PASSWORD="change-me"

# Any long random text, used to secure the admin login cookie.
# On a Mac you can generate one with:  openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"
